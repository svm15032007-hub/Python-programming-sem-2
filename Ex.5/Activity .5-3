# program to list of purchased items
"""
Created on Tue Mar 24 11:17:29 2026

@author: shraddha mahajan
"""

# List of purchased items
purchases = ["Apple", "Banana", "Apple", "Orange", "Banana", "Apple"]

# Create empty dictionary
frequency = {}

# Count frequency
for item in purchases:
    if item in frequency:
        frequency[item] += 1
    else:
        frequency[item] = 1

# Print result
print(frequency)
