# ATM Withdrawal System

balance = 10000   # Initial balance

print("Welcome to ATM")
withdraw = int(input("Enter amount to withdraw: "))

if withdraw <= balance:
    balance -= withdraw
    print("Transaction Successful")
    print("Remaining Balance:", balance)
else:
    print("Insufficient Balance")
