# Prevent crash when dividing bill among zero people
"""
Created on Tue Apr 28 10:46:36 2026

@author: Shraddha mahajan
"""

try:
    total_bill = float(input("Enter total bill amount: "))
    people = int(input("Enter number of people: "))

    if people <= 0:
        print("Invalid input! Number of people must be greater than zero.")
    else:
        share = total_bill / people
        print("Each person should pay:", share)

except ValueError:
    print("Invalid input! Please enter valid numbers.")
