# Remove duplicate mobile numbers (preserves order)
numbers = ["9876543210", "9123456780", "9876543210", "9988776655"]

unique_numbers = []
for num in numbers:
    if num not in unique_numbers:
        unique_numbers.append(num)

print("Unique Mobile Numbers:", unique_numbers)
