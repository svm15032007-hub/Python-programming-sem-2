from datetime import datetime

def show_today_date():
    today = datetime.now()
    formatted_date = today.strftime("%d-%m-%Y")
    
    print("=== Hospital Appointment System ===")
    print("Today's Date:", formatted_date)

# Run function
show_today_date()
